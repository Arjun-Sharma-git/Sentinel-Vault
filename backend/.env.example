# Copy to backend/.env and adjust. Every setting is documented in app/config.py.

# ---- Runtime --------------------------------------------------------------------------
# production refuses the dev passwords/keys below and requires COOKIE_SECURE=true (HTTPS)
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_ORIGIN=http://localhost:5174

# ---- Services (docker compose) -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://vault:vault-dev-password@127.0.0.1:5433/vault
AUTHZ_BACKEND=openfga            # or sql: same rules, evaluated from Postgres, no OpenFGA
OPENFGA_URL=http://127.0.0.1:8081
OPENFGA_API_KEY=vault-dev-openfga-key
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=vault-dev-qdrant-key

# ---- Models (Ollama) ---------------------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
# Laptop (16 GB, CPU): qwen3.5:4b with a 4096-token context.
# RX 9070 XT desktop (16 GB VRAM, 32 GB RAM): qwen3.5:9b, or gpt-oss:20b, with 16384.
LLM_MODEL=qwen3.5:4b
LLM_CONTEXT_TOKENS=4096
# Must be the same on every machine that shares the index; changing it needs
#   uv run python -m app.cli reindex --recreate
EMBEDDING_MODEL=qwen3-embedding:0.6b

# ---- Prompt gate --------------------------------------------------------------------------
GATE_ENGINE=laya                 # laya | heuristic | off
GATE_INJECTION_THRESHOLD=0.5
GATE_EXFILTRATION_THRESHOLD=0.6
# Hindi and other non-Latin scripts (Laya's multilingual checkpoint); refit with `app.cli gate-eval`
GATE_MULTILINGUAL_INJECTION_THRESHOLD=0.93
GATE_MULTILINGUAL_EXFILTRATION_THRESHOLD=0.61
GATE_REVIEW_THRESHOLD=0.5        # allowed prompts at or above this are audited as gate.review
GATE_SECOND_STAGE=review         # off | review | all: LLM second look at Hindi and Hinglish prompts
# GATE_SECOND_STAGE_MODEL=        (default: LLM_MODEL)

# ---- Library --------------------------------------------------------------------------------
# LIBRARY_DIR=/path/to/your/department/folders   (default: data/library in the repo)
MAX_UPLOAD_MB=50
RETRIEVAL_TOP_K=6
# Reorder candidates with a cross-encoder: cross-encoder (MiniLM, CPU-friendly) | qwen (GPU) | off
RERANKER=cross-encoder
RERANK_CANDIDATES=12

# ---- Sign-in throttling -------------------------------------------------------------------
LOGIN_MAX_FAILURES=5             # per account, within the window
LOGIN_IP_MAX_FAILURES=30         # per client address
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
# true only behind a reverse proxy that sets X-Forwarded-For (the Vite dev proxy does)
TRUST_PROXY_HEADERS=false

# ---- Parsing untrusted files (sandboxed child process) ---------------------------------------
PARSE_TIMEOUT_SECONDS=300
PARSE_MEMORY_MB=6144             # 0 = no cap; ignored on GPU (ROCm/CUDA reserve huge address space)
PARSE_MAX_FILE_MB=200
PARSE_MAX_PAGES=500
ZIP_MAX_UNCOMPRESSED_MB=500
ZIP_MAX_RATIO=100
PARSE_NETWORK_ISOLATION=auto     # auto | on | off  (needs: uv run python -m app.cli download-docling)
