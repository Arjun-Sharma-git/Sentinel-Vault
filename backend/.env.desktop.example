# Desktop profile: Ryzen 7 9800X3D, 32 GB RAM, Radeon RX 9070 XT 16 GB, Linux with ROCm.
# Copy to backend/.env on the desktop, then start with:  ./run.sh --gpu rocm
# (Values not listed here keep the defaults from .env.example.)

# Laya (prompt gate) and Docling (PDF layout/OCR) on the GPU. Needs the ROCm PyTorch build,
# which `./run.sh --gpu rocm` installs (uv sync --no-group cpu --group rocm, ~9 GB).
TORCH_DEVICE=rocm

# A larger answer model and context: fits in 16 GB of VRAM next to the embedding model.
#   qwen3.5:9b   best grounded answers at this size
#   gpt-oss:20b  stronger reasoning, ~92 tok/s on the 9070 XT (MXFP4)
LLM_MODEL=qwen3.5:9b
LLM_CONTEXT_TOKENS=16384
LLM_KEEP_ALIVE=10m

# Must match every other machine that shares the index.
EMBEDDING_MODEL=qwen3-embedding:0.6b

# More context per answer now that it's cheap.
RETRIEVAL_TOP_K=8
CHUNK_MAX_TOKENS=400
